{
  "name": "spain-alert-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "generar-datos": "tsx src/scripts/generarDatos.ts",
    "sondar-fuentes": "tsx src/scripts/sondaFuentes.ts",
    "test": "tsx src/pruebas/embalses.prueba.ts && tsx src/pruebas/avisos.prueba.ts && tsx src/pruebas/estaciones.prueba.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sondar-prediccion": "tsx src/scripts/sondaPrediccion.ts"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "@types/proj4": "^2.5.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fast-xml-parser": "^4.5.0",
    "node-fetch": "^3.3.2",
    "proj4": "^2.21.0",
    "tar-stream": "^3.1.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.9.0",
    "@types/tar-stream": "^3.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
